<div class="hw-layout">
  <section class="hw-controls">
    <form class="hw-form">
      <fieldset>
        <legend>{{localize "HEXWORLD.World"}}</legend>
        <div class="form-group">
          <label>{{localize "HEXWORLD.SceneName"}}</label>
          <input type="text" name="sceneName" value="{{p.sceneName}}">
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Seed"}}</label>
          <div class="hw-seed">
            <input type="text" name="seed" value="{{p.seed}}">
            <button type="button" data-action="randomSeed" data-tooltip="{{localize 'HEXWORLD.RandomSeed'}}">
              <i class="fa-solid fa-dice"></i>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Template"}}</label>
          <select name="template">
            {{#each templates}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </fieldset>

      <fieldset>
        <legend>{{localize "HEXWORLD.Grid"}}</legend>
        <div class="form-group">
          <label>{{localize "HEXWORLD.GridType"}}</label>
          <select name="gridType">
            {{#each gridTypes}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="form-group hw-pair">
          <label>{{localize "HEXWORLD.Columns"}}</label>
          <input type="number" name="cols" value="{{p.cols}}" min="8" max="250" step="1">
          <label>{{localize "HEXWORLD.Rows"}}</label>
          <input type="number" name="rows" value="{{p.rows}}" min="8" max="250" step="1">
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.CellSize"}}</label>
          <input type="number" name="cellSize" value="{{p.cellSize}}" min="50" max="300" step="10">
        </div>
        <div class="form-group hw-pair">
          <label>{{localize "HEXWORLD.Distance"}}</label>
          <input type="number" name="distance" value="{{p.distance}}" min="0.01" step="any">
          <label>{{localize "HEXWORLD.Units"}}</label>
          <input type="text" name="units" value="{{p.units}}">
        </div>
      </fieldset>

      <fieldset>
        <legend>{{localize "HEXWORLD.Terrain"}}</legend>
        <div class="form-group">
          <label>{{localize "HEXWORLD.WaterPct"}}</label>
          <div class="hw-range">
            <input type="range" name="waterFraction" value="{{p.waterFraction}}" min="0.1" max="0.85" step="0.01">
            <output></output>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Climate"}}</label>
          <select name="climate">
            {{#each climates}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Moisture"}}</label>
          <div class="hw-range">
            <input type="range" name="moisture" value="{{p.moisture}}" min="0.5" max="1.5" step="0.05">
            <output></output>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Rivers"}}</label>
          <div class="hw-range">
            <input type="range" name="riverDensity" value="{{p.riverDensity}}" min="0" max="1" step="0.05">
            <output></output>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Settlements"}}</label>
          <div class="hw-range">
            <input type="range" name="settlements" value="{{p.settlements}}" min="0" max="1" step="0.05">
            <output></output>
          </div>
        </div>
        <div class="form-group">
          <label>{{localize "HEXWORLD.Realms"}}</label>
          <div class="hw-range">
            <input type="range" name="realms" value="{{p.realms}}" min="0" max="1" step="0.05">
            <output></output>
          </div>
        </div>
      </fieldset>
    </form>

    {{#if editSceneName}}
    <p class="hw-editing-note"><i class="fa-solid fa-sliders"></i> {{localize "HEXWORLD.EditingScene"}} <strong>{{editSceneName}}</strong></p>
    {{/if}}
    <div class="hw-buttons">
      <button type="button" class="hw-generate" data-action="generate">
        <i class="fa-solid fa-mountain-sun"></i> {{localize "HEXWORLD.Generate"}}
      </button>
      {{#if editSceneName}}
      <button type="button" class="hw-apply" data-action="applyToScene" disabled>
        <i class="fa-solid fa-floppy-disk"></i> {{localize "HEXWORLD.ApplyToScene"}}
      </button>
      {{/if}}
      <button type="button" class="hw-create" data-action="createScene" disabled>
        <i class="fa-solid fa-map"></i> {{localize "HEXWORLD.CreateScene"}}
      </button>
    </div>
  </section>

  <section class="hw-preview">
    <div class="hw-editbar disabled">
      <div class="hw-editbar-row">
        <span class="hw-editbar-label">{{localize "HEXWORLD.EditTools"}}</span>
        <label>{{localize "HEXWORLD.BrushRadius"}}</label>
        <input type="range" name="brushRadius" min="0.1" max="8" step="0.1" value="3" disabled>
        <label>{{localize "HEXWORLD.BrushStrength"}}</label>
        <input type="range" name="brushStrength" min="0.02" max="0.15" step="0.01" value="0.06" disabled>
        <button type="button" data-action="undoEdit" data-tooltip="{{localize 'HEXWORLD.Undo'}}" disabled>
          <i class="fa-solid fa-rotate-left"></i>
        </button>
        <button type="button" data-action="redoEdit" data-tooltip="{{localize 'HEXWORLD.Redo'}}" disabled>
          <i class="fa-solid fa-rotate-right"></i>
        </button>
        <button type="button" data-action="resetEdits" data-tooltip="{{localize 'HEXWORLD.ResetEdits'}}" disabled>
          <i class="fa-solid fa-eraser"></i>
        </button>
        <select name="viewMode" data-tooltip="{{localize 'HEXWORLD.View'}}">
          <option value="terrain">{{localize "HEXWORLD.ViewTerrain"}}</option>
          <option value="height">{{localize "HEXWORLD.ViewHeight"}}</option>
          <option value="temp">{{localize "HEXWORLD.ViewTemp"}}</option>
          <option value="moist">{{localize "HEXWORLD.ViewMoist"}}</option>
          <option value="realms">{{localize "HEXWORLD.ViewRealms"}}</option>
        </select>
        <label class="hw-art-toggle" data-tooltip="{{localize 'HEXWORLD.UseBiomeArt'}}">
          <input type="checkbox" name="showArt"> {{localize "HEXWORLD.ShowArt"}}
        </label>
      </div>
      <div class="hw-editbar-row">
      <button type="button" data-tool="raise" data-tooltip="{{localize 'HEXWORLD.ToolRaise'}}" disabled>
        <i class="fa-solid fa-arrow-up-from-ground-water"></i>
      </button>
      <button type="button" data-tool="lower" data-tooltip="{{localize 'HEXWORLD.ToolLower'}}" disabled>
        <i class="fa-solid fa-arrow-down"></i>
      </button>
      <button type="button" data-tool="smooth" data-tooltip="{{localize 'HEXWORLD.ToolSmooth'}}" disabled>
        <i class="fa-solid fa-wand-magic-sparkles"></i>
      </button>
      <button type="button" data-tool="water" data-tooltip="{{localize 'HEXWORLD.ToolWater'}}" disabled>
        <i class="fa-solid fa-water"></i>
      </button>
      <button type="button" data-tool="land" data-tooltip="{{localize 'HEXWORLD.ToolLand'}}" disabled>
        <i class="fa-solid fa-seedling"></i>
      </button>
      <button type="button" data-tool="mountain" data-tooltip="{{localize 'HEXWORLD.ToolMountain'}}" disabled>
        <i class="fa-solid fa-mountain"></i>
      </button>
      <button type="button" data-tool="biome" data-tooltip="{{localize 'HEXWORLD.ToolBiome'}}" disabled>
        <i class="fa-solid fa-palette"></i>
      </button>
      <button type="button" data-tool="riverAdd" data-tooltip="{{localize 'HEXWORLD.ToolRiverAdd'}}" disabled>
        <i class="fa-solid fa-wave-square"></i>
      </button>
      <button type="button" data-tool="riverRemove" data-tooltip="{{localize 'HEXWORLD.ToolRiverRemove'}}" disabled>
        <i class="fa-solid fa-droplet-slash"></i>
      </button>
      <span class="hw-palette-sep"></span>
      <button type="button" data-tool="site" data-tooltip="{{localize 'HEXWORLD.ToolSite'}}" disabled>
        <i class="fa-solid fa-location-dot"></i>
      </button>
      <button type="button" data-tool="rename" data-tooltip="{{localize 'HEXWORLD.ToolRename'}}" disabled>
        <i class="fa-solid fa-signature"></i>
      </button>
      <button type="button" data-tool="labelMove" data-tooltip="{{localize 'HEXWORLD.ToolLabelMove'}}" disabled>
        <i class="fa-solid fa-arrows-up-down-left-right"></i>
      </button>
      <button type="button" data-tool="roadMinor" data-tooltip="{{localize 'HEXWORLD.ToolRoadMinor'}}" disabled>
        <i class="fa-solid fa-shoe-prints"></i>
      </button>
      <button type="button" data-tool="roadMajor" data-tooltip="{{localize 'HEXWORLD.ToolRoadMajor'}}" disabled>
        <i class="fa-solid fa-road"></i>
      </button>
      <button type="button" data-tool="roadErase" data-tooltip="{{localize 'HEXWORLD.ToolRoadErase'}}" disabled>
        <i class="fa-solid fa-road-circle-xmark"></i>
      </button>
      <span class="hw-palette-sep"></span>
      <button type="button" data-action="regenSites" data-tooltip="{{localize 'HEXWORLD.RegenSettlements'}}" disabled>
        <i class="fa-solid fa-arrows-rotate"></i>
      </button>
      </div>
    </div>
    <div class="hw-palette hw-palette-bar">
      {{#each biomeSwatches}}
      <button type="button" class="hw-swatch{{#if active}} active{{/if}}" data-biome="{{id}}"
              data-tooltip="{{label}}" style="--swatch: {{color}}" disabled></button>
      {{/each}}
      <button type="button" class="hw-swatch hw-swatch-erase" data-biome="255"
              data-tooltip="{{localize 'HEXWORLD.BiomeErase'}}" disabled><i class="fa-solid fa-eraser"></i></button>
      <span class="hw-palette-sep"></span>
      {{#each siteTypes}}
      <button type="button" class="hw-swatch hw-site-swatch{{#if active}} active{{/if}}" data-site="{{id}}"
              data-tooltip="{{label}}" disabled><i class="{{icon}}"></i></button>
      {{/each}}
    </div>
    <div class="hw-canvas-wrap">
      <canvas class="hw-canvas" width="640" height="480"></canvas>
      <div class="hw-brush-cursor"></div>
    </div>
    <div class="hw-inspect"></div>
    <div class="hw-stats">{{localize "HEXWORLD.NoWorld"}}</div>
  </section>
</div>
