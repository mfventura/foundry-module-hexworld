<div class="hw-icon-config">
  <p class="hint">{{localize "HEXWORLD.IconMenuHint"}}</p>
  <fieldset>
    <legend>{{localize "HEXWORLD.MarkerStyle"}}</legend>
    <div class="hw-style-row">
      <button type="button" class="hw-style-btn{{#if badgeActive}} active{{/if}}" data-style="badge">
        <i class="fa-solid fa-circle-dot"></i> {{localize "HEXWORLD.MarkerBadge"}}
      </button>
      <button type="button" class="hw-style-btn{{#if plainActive}} active{{/if}}" data-style="plain">
        <i class="fa-solid fa-font"></i> {{localize "HEXWORLD.MarkerPlain"}}
      </button>
    </div>
  </fieldset>
  {{#each rows}}
  <fieldset data-type="{{type}}">
    <legend>{{typeLabel}}</legend>
    <div class="hw-palette">
      {{#each options}}
      <button type="button" class="hw-swatch hw-site-swatch{{#if active}} active{{/if}}" data-icon="{{name}}"
              data-tooltip="{{label}}"><i class="fa-solid {{name}}"></i></button>
      {{/each}}
    </div>
  </fieldset>
  {{/each}}
  <button type="button" class="hw-save" data-action="save">
    <i class="fa-solid fa-floppy-disk"></i> {{localize "HEXWORLD.Save"}}
  </button>
</div>
