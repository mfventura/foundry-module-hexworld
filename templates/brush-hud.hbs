<div class="hw-hud">
  <div class="hw-hud-title"><i class="fa-solid fa-paintbrush"></i> {{localize "HEXWORLD.EditTools"}}</div>
  <div class="hw-hud-row">
    <label>{{localize "HEXWORLD.BrushRadius"}}</label>
    <input type="range" name="radius" min="1" max="8" step="1" value="{{radius}}">
    <output></output>
  </div>
  <div class="hw-hud-row">
    <label>{{localize "HEXWORLD.BrushStrength"}}</label>
    <input type="range" name="strength" min="0.02" max="0.15" step="0.01" value="{{strength}}">
    <output></output>
  </div>
  <div class="hw-hud-row">
    <label>{{localize "HEXWORLD.ShowLabels"}}</label>
    <input type="checkbox" name="showLabels" {{#if showLabels}}checked{{/if}}>
  </div>
  <div class="hw-hud-row">
    <label>{{localize "HEXWORLD.View"}}</label>
    <select name="viewMode">
      <option value="terrain" {{#if (eq viewMode "terrain")}}selected{{/if}}>{{localize "HEXWORLD.ViewTerrain"}}</option>
      <option value="height" {{#if (eq viewMode "height")}}selected{{/if}}>{{localize "HEXWORLD.ViewHeight"}}</option>
      <option value="temp" {{#if (eq viewMode "temp")}}selected{{/if}}>{{localize "HEXWORLD.ViewTemp"}}</option>
      <option value="moist" {{#if (eq viewMode "moist")}}selected{{/if}}>{{localize "HEXWORLD.ViewMoist"}}</option>
      <option value="realms" {{#if (eq viewMode "realms")}}selected{{/if}}>{{localize "HEXWORLD.ViewRealms"}}</option>
    </select>
  </div>
  <div class="hw-hud-subtitle">{{localize "HEXWORLD.ToolBiome"}}</div>
  <div class="hw-palette">
    {{#each swatches}}
    <button type="button" class="hw-swatch{{#if active}} active{{/if}}" data-biome="{{id}}"
            data-tooltip="{{label}}" style="--swatch: {{color}}"></button>
    {{/each}}
    <button type="button" class="hw-swatch hw-swatch-erase{{#if eraserActive}} active{{/if}}" data-biome="255"
            data-tooltip="{{localize 'HEXWORLD.BiomeErase'}}"><i class="fa-solid fa-eraser"></i></button>
  </div>
  <div class="hw-hud-subtitle">{{localize "HEXWORLD.SitesTitle"}}</div>
  <div class="hw-palette">
    {{#each siteTypes}}
    <button type="button" class="hw-swatch hw-site-swatch{{#if active}} active{{/if}}" data-site="{{id}}"
            data-tooltip="{{label}}"><i class="{{icon}}"></i></button>
    {{/each}}
  </div>
  <div class="hw-hud-subtitle">{{localize "HEXWORLD.RealmsTitle"}}</div>
  <div class="hw-palette">
    {{#each realmSwatches}}
    <button type="button" class="hw-swatch hw-realm-swatch{{#if active}} active{{/if}}" data-realm="{{id}}"
            data-tooltip="{{label}}" style="--swatch: {{color}}">{{#if erase}}<i class="fa-solid fa-eraser"></i>{{/if}}</button>
    {{/each}}
  </div>
  <div class="hw-hud-actions">
    <button type="button" class="hw-realm-new" data-tooltip="{{localize 'HEXWORLD.RealmNew'}}">
      <i class="fa-solid fa-plus"></i>
    </button>
    <button type="button" class="hw-realm-rename" data-tooltip="{{localize 'HEXWORLD.RealmRename'}}">
      <i class="fa-solid fa-signature"></i>
    </button>
    <button type="button" class="hw-realm-delete" data-tooltip="{{localize 'HEXWORLD.RealmDelete'}}">
      <i class="fa-solid fa-trash"></i>
    </button>
  </div>
  <button type="button" class="hw-sea-btn"><i class="fa-solid fa-arrow-up-from-water-pump"></i> {{localize "HEXWORLD.SeaLevel"}}</button>
  <div class="hw-hud-info"></div>
</div>
