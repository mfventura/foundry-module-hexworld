<div class="hw-art-config">
  <p class="hint">{{localize "HEXWORLD.BiomeArtMenuHint"}}</p>
  <div class="hw-art-rows">
    {{#each rows}}
    <div class="hw-art-row" data-biome="{{id}}">
      <span class="hw-art-thumb" style="--swatch: {{color}}">
        {{#if path}}<img src="{{path}}" alt="{{label}}">{{/if}}
      </span>
      <span class="hw-art-name">
        <strong>{{label}}</strong>
        <span class="hw-art-file">{{fileName}}</span>
      </span>
      <button type="button" class="hw-art-browse" data-tooltip="{{localize 'HEXWORLD.BiomeArtBrowse'}}">
        <i class="fa-solid fa-folder-open"></i>
      </button>
      <button type="button" class="hw-art-clear" data-tooltip="{{localize 'HEXWORLD.BiomeArtFlatTip'}}" {{#unless path}}disabled{{/unless}}>
        <i class="fa-solid fa-fill-drip"></i>
      </button>
      <button type="button" class="hw-art-reset" data-tooltip="{{localize 'HEXWORLD.BiomeArtReset'}}" {{#if isDefault}}disabled{{/if}}>
        <i class="fa-solid fa-rotate-left"></i>
      </button>
    </div>
    {{/each}}
  </div>
  <button type="button" class="hw-save" data-action="save">
    <i class="fa-solid fa-floppy-disk"></i> {{localize "HEXWORLD.Save"}}
  </button>
</div>
